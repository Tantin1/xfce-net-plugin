[Xfce Panel]
Type=X-XFCE-PanelPlugin
Name=Network Connections
Name[de]=Netzwerkverbindungen
Name[es]=Conexiones de red
Name[fr]=Connexions réseau
Name[it]=Connessioni di rete
Name[ja]=ネットワーク接続
Name[nl]=Netwerkverbindingen
Name[pl]=Połączenia sieciowe
Name[pt_BR]=Conexões de rede
Name[ru]=Сетевые подключения
Name[zh_CN]=网络连接
Comment=Manage Wi-Fi and Ethernet connections from the Xfce panel
Comment[de]=WLAN- und Ethernet-Verbindungen über die Xfce-Leiste verwalten
Comment[es]=Gestiona conexiones Wi-Fi y Ethernet desde el panel de Xfce
Comment[fr]=Gérez les connexions Wi-Fi et Ethernet depuis le tableau de bord Xfce
Comment[it]=Gestisci le connessioni Wi-Fi ed Ethernet dal pannello di Xfce
Comment[ja]=Xfce パネルから Wi-Fi と Ethernet の接続を管理します
Comment[nl]=Beheer wifi- en ethernetverbindingen vanuit het Xfce-paneel
Comment[pl]=Zarządzaj połączeniami Wi-Fi i Ethernet z panelu Xfce
Comment[pt_BR]=Gerencie conexões Wi-Fi e Ethernet pelo painel do Xfce
Comment[ru]=Управление подключениями Wi-Fi и Ethernet с панели Xfce
Comment[zh_CN]=从 Xfce 面板管理 Wi-Fi 和以太网连接
Icon=network-wireless
X-XFCE-Module=xfce-net-plugin
X-XFCE-Module-Path=@plugin_dir@
X-XFCE-Internal=false
X-XFCE-Unique=false
X-XFCE-API=2.0
