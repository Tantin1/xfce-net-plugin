--- popup.c	2026-05-22 03:11:16.524832266 +0000
+++ popup.c	2026-05-22 03:11:16.525259351 +0000
@@ -758,14 +758,16 @@
         return;
 
     gdouble cur    = gtk_adjustment_get_value (adj);
-    gdouble page   = gtk_adjustment_get_page_size (adj);
+    /* Usar el alto real asignado al scroll en vez de page_size, que puede no
+     * reflejar el área visible exacta debido a bordes y decoraciones. */
+    gdouble visible = (gdouble) gtk_widget_get_allocated_height (scroll);
     gdouble top    = (gdouble) expand_y;
     gdouble bottom = top + (gdouble) alloc->height;
 
     /* Mover lo mínimo necesario para que el expand sea completamente visible. */
-    if (bottom > cur + page)
-        gtk_adjustment_set_value (adj, MIN (bottom - page,
-                                            gtk_adjustment_get_upper (adj) - page));
+    if (bottom > cur + visible)
+        gtk_adjustment_set_value (adj, MIN (bottom - visible,
+                                            gtk_adjustment_get_upper (adj) - visible));
     else if (top < cur)
         gtk_adjustment_set_value (adj, top);
 }
