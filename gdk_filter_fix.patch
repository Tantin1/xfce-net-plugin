+static GdkFilterReturn
+on_gdk_event_filter (GdkXEvent *xevent, GdkEvent *event, gpointer data)
+{
+    NetPopup *popup = data;
+
+    if (!popup->event_filter_active)
+        return GDK_FILTER_CONTINUE;
+
+    /* Solo nos interesan clicks de mouse. */
+    if (event->type != GDK_BUTTON_PRESS)
+        return GDK_FILTER_CONTINUE;
+
+    /* Si el click fue dentro del popup, no cerrar. */
+    gint px, py, pw, ph;
+    gtk_window_get_position (GTK_WINDOW (popup->window), &px, &py);
+    gtk_window_get_size     (GTK_WINDOW (popup->window), &pw, &ph);
+
+    gdouble ex = event->button.x_root;
+    gdouble ey = event->button.y_root;
+
+    if (ex >= px && ex <= px + pw && ey >= py && ey <= py + ph)
+        return GDK_FILTER_CONTINUE;
+
+    /* Click fuera del popup — cerrar. */
+    popup_hide (popup);
+    return GDK_FILTER_CONTINUE;
+}
